{
  "name": "@telegram-tools/ui-kit",
  "private": false,
  "version": "0.1.0-dev.1",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "yarn build && yarn build-storybook",
    "build:demo": "yarn build && yarn build-storybook && mkdir -p dist/storybook && cp -r storybook-static/* dist/storybook/",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "version:patch": "yarn version patch",
    "version:minor": "yarn version minor",
    "version:major": "yarn version major",
    "release": "yarn build && yarn version:patch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:changeset": "yarn build && changeset publish",
    "release:dev": "yarn changeset && yarn version-packages && yarn build && npm publish --tag dev",
    "release:prod": "yarn changeset && yarn version-packages && yarn build && npm publish"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react-remove-scroll": "^2.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@chromatic-com/storybook": "^4.0.1",
    "@eslint/js": "^9.30.1",
    "@storybook/addon-a11y": "^9.0.17",
    "@storybook/addon-docs": "^9.0.16",
    "@storybook/addon-essentials": "^9.0.0-alpha.11",
    "@storybook/addon-onboarding": "^9.0.16",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/addon-themes": "^9.0.16",
    "@storybook/addon-vitest": "^9.0.17",
    "@storybook/react": "^9.0.16",
    "@storybook/react-vite": "^9.0.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.0.16",
    "globals": "^16.3.0",
    "playwright": "^1.54.1",
    "sass": "^1.89.2",
    "storybook": "^9.0.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
